<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analyst Dashboard"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnLiveCamera"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Detect via Camera"
        android:textSize="18sp"
        android:backgroundTint="#009688"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnUploadImage"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Upload from Gallery"
        android:textSize="18sp"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnViewMap"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="View Water Quality Map"
        android:textSize="18sp"
        android:backgroundTint="#FF9800"/>
    <Button
        android:id="@+id/btnHelp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Help &amp; Guide"
        android:backgroundTint="#795548"
        android:layout_marginBottom="20dp"/>
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="40dp"
        android:backgroundTint="#D32F2F"/>

</LinearLayout>